{
  "name": "atelier-aurelia-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@atelier-aurelia/studio",
    "infra:start": "docker compose --env-file .env -f infra/compose.yml up -d",
    "infra:stop": "docker compose --env-file .env -f infra/compose.yml down",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs tests/aws/*.test.mjs && npm run test:unit && npm run test --workspaces --if-present",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.mjs tests/aws/*.test.mjs && vitest run --coverage && npm run test:coverage --workspaces --if-present",
    "lint": "eslint tests eslint.config.mjs tools && npm run lint --workspaces --if-present",
    "guardrails": "node tools/architecture-guardrails.mjs",
    "test:storage": "vitest run --config tests/storage/vitest.config.mts",
    "test:workflows": "vitest run --config tests/workflows/vitest.config.mts",
    "test:aws:offline": "node --test tests/aws/*.test.mjs",
    "test:aws": "vitest run --config tests/aws/vitest.config.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "supabase": "^2.39.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
