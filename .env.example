# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and worker only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AWS S3 in production; MinIO locally through the same adapter
OBJECT_STORAGE_BUCKET=atelier-aurelia-artifacts
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ARTIFACT_SIGNED_URL_TTL_SECONDS=300

# Trigger.dev Cloud v4
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
