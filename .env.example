# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and worker only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AWS S3 in production; MinIO locally through the same adapter
OBJECT_STORAGE_BUCKET=atelier-aurelia-artifacts
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local runtime user: distinct from MINIO_ROOT_USER; no administration/delete permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credential for cloud S3; leave empty for MinIO.
AWS_SESSION_TOKEN=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ARTIFACT_SIGNED_URL_TTL_SECONDS=60

# Optional Trigger.dev Cloud v4 adapter; not required by the local worker.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Dedicated LOGIN granted atelier_worker only; never use postgres/service-role credentials.
# Use a direct connection or SESSION pooler (transaction pooling breaks execution locks).
# Remote connections require sslmode=verify-full.
WORKER_DATABASE_URL=
# Deployment/CLI credential only (or interactive CLI login); not the environment API key.
TRIGGER_ACCESS_TOKEN=

# Optional CE-02 local planning adapter. Unset means provider unavailable.
# POST GenerationRequest JSON -> raw CreativePlanV1 JSON; literal loopback only.
PLANNING_PROVIDER_URL=
PLANNING_PROVIDER_ID=
PLANNING_PROVIDER_VERSION=
PLANNING_PROMPT_VERSION=
