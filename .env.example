# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and worker only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AWS S3 in production; MinIO locally through the same adapter
OBJECT_STORAGE_BUCKET=atelier-aurelia-artifacts
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local runtime user: distinct from MINIO_ROOT_USER; no administration/delete permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credential for cloud S3; leave empty for MinIO.
AWS_SESSION_TOKEN=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ARTIFACT_SIGNED_URL_TTL_SECONDS=60

# Optional Trigger.dev Cloud v4 adapter; not required by the local worker.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Dedicated LOGIN granted atelier_worker only; never use postgres/service-role credentials.
# Use a direct connection or SESSION pooler (transaction pooling breaks execution locks).
# Remote connections require sslmode=verify-full.
WORKER_DATABASE_URL=
# Deployment/CLI credential only (or interactive CLI login); not the environment API key.
TRIGGER_ACCESS_TOKEN=

# Optional CE-02 local planning adapter. Unset means provider unavailable.
# POST GenerationRequest JSON -> raw CreativePlanV1 JSON; literal loopback only.
PLANNING_PROVIDER_URL=
PLANNING_PROVIDER_ID=
PLANNING_PROVIDER_VERSION=
PLANNING_PROMPT_VERSION=
# CE-02.1 trusted planning persistence: dedicated LOGIN granted only atelier_planning_writer.
# No postgres, service-role, or worker credential fallback. Keep server-only.
PLANNING_DATABASE_URL=
# Opt in ONLY for a trusted local Docker network using db, host.docker.internal,
# or supabase_db_atelier-aurelia-studio. Other remote hosts always require verify-full TLS.
PLANNING_DATABASE_LOCAL_DOCKER=0

# CE-02.2: local (legacy), fixture (no AI/no network), or live.
PLANNING_PROVIDER_MODE=
# Fixture mode selects fixed test data explicitly; never routes by the owner's idea.
PLANNING_FIXTURE=reading
# Set true ONLY after authorizing provider spending. Default off; no automatic fallback.
PLANNING_LIVE_ENABLED=false
# Full OpenAI-compatible chat completions URL (HTTPS, or literal loopback HTTP).
PLANNING_LIVE_URL=
PLANNING_LIVE_API_KEY=
PLANNING_LIVE_MODEL=
# Operator estimate for one request INCLUDING up to three attempts; NOT a billing cap.
PLANNING_LIVE_EXPECTED_REQUEST_COST_USD=
# Each attempt is bounded to at most 30s, below the existing 120s reservation lifetime.
PLANNING_LIVE_TIMEOUT_MS=30000
PLANNING_LIVE_MAX_TOKENS=6000
